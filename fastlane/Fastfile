default_platform(:ios)

BUNDLE_ID = "is.any.app.danmubao"

# App Store Connect API 密钥（ASC → Users and Access → Integrations → App Store Connect API 生成）
# 用环境变量传入，不要提交进仓库：
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH(.p8 路径) / ASC_TEAM_ID
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false
  )
end

platform :ios do
  desc "①一次性：在 App Store Connect 创建 app 记录"
  lane :create_app do
    produce(
      api_key: asc_api_key,
      app_identifier: BUNDLE_ID,
      app_name: "LED Banner - Scrolling Text",  # 主语言名称（可改）
      language: "en-US",
      sku: "danmubao-001",                       # 任意唯一标识（可改）
      team_id: ENV["ASC_TEAM_ID"]
    )
  end

  desc "构建前端 H5 产物 + 重新生成 Xcode 工程（打包前置）"
  lane :prepare do
    repo = File.expand_path("../..", __dir__)   # 仓库根
    ios  = File.expand_path("..", __dir__)       # ios/
    sh("cd '#{repo}' && npm run build:h5")
    sh("cd '#{ios}' && xcodegen generate")
  end

  desc "自动生成各语言截图（snapshot，配置见 Snapfile）"
  lane :screenshots do
    prepare
    capture_screenshots                       # 跑 UI 测试，截到 fastlane/screenshots/
  end

  desc "②上传商店文案/元数据（不含二进制）"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,                    # 截图就绪后改 false
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "上传截图到 App Store Connect（先跑过 screenshots）"
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "③打包 IPA（Release / App Store 分发 / 自动签名）"
  lane :build do
    prepare
    build_app(
      project: "Danmubao.xcodeproj",
      scheme: "Danmubao",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Danmubao.ipa",
      # 自动签名：用 API 密钥让 Xcode 自动创建分发证书/描述文件
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        teamID: ENV["ASC_TEAM_ID"],
        signingStyle: "automatic"
      }
    )
  end

  desc "④打包并上传到 TestFlight（内测）"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "⑤完整发布：构建 + 上传二进制 + 上传元数据（默认不自动提审）"
  lane :release do
    build
    deliver(
      api_key: asc_api_key,
      ipa: "build/Danmubao.ipa",
      skip_binary_upload: false,
      skip_screenshots: true,                    # 截图就绪后改 false
      run_precheck_before_submit: false,
      submit_for_review: false,                  # 改 true 可自动提审
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end

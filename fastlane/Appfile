# Fastlane Appfile —— app 标识与账号信息
# 鉴权走 App Store Connect API 密钥（见 Fastfile / README），不需要 Apple ID 密码。

app_identifier("is.any.app.danmubao")   # 与 Xcode 工程 Bundle ID 一致

# 首次用 `produce` 建 app 记录时需要你的开发者 Team ID（ASC → Membership 里查）。
# 放到环境变量 ASC_TEAM_ID，避免写死在仓库。
team_id(ENV["ASC_TEAM_ID"]) if ENV["ASC_TEAM_ID"]
